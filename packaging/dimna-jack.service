# dimna-jack.service: a systemd *user* unit that runs JACK (jackd, JACK2) on the sound card
# while dimna runs, so dimna's spike audio reaches the card without going through PipeWire.
# dimna's launchers (dimna-launch.sh, dimna-desktop-launch.sh) start it before dimna if it is
# installed, and stop it when dimna exits, then start PipeWire again. dimna itself only
# connects to a running server (audio_output = "jack" or "auto" in its config).
#
# Install (as the user, no root):
#   mkdir -p ~/.config/systemd/user
#   cp dimna-jack.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
# The card, the period and the number of periods per machine, with a drop-in:
#   systemctl --user edit dimna-jack.service
#     [Service]
#     Environment=DIMNA_JACK_DEVICE=hw:PCH
# `aplay -l` lists the cards. See docs/install.md, "Spike audio through JACK".
#
# Starting it stops PipeWire and WirePlumber, their sockets too (Conflicts=): otherwise the
# next program that wants sound would start PipeWire again, and the two would fight over the
# card. Stopping it does not start them again: the launchers do that. Nothing that plays
# through PipeWire or PulseAudio has sound meanwhile, and screen sharing through the desktop
# portal stops working.

[Unit]
Description=JACK on the sound card, for dimna's spike audio
Conflicts=pipewire.socket pipewire-pulse.socket pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=simple
# Defaults that are safe anywhere: the first card, 64-frame periods, two of them.
Environment=DIMNA_JACK_DEVICE=hw:0
Environment=DIMNA_JACK_PERIOD=64
Environment=DIMNA_JACK_PERIODS=2
# -R -P 60: real-time, below dimna's acquisition thread (SCHED_FIFO 70), so sound can never
# delay acquisition. JACK2 runs its clients' process threads 5 lower (dimna's at 55).
ExecStart=/usr/bin/jackd -R -P 60 -d alsa -d ${DIMNA_JACK_DEVICE} -r 48000 -p ${DIMNA_JACK_PERIOD} -n ${DIMNA_JACK_PERIODS}
# Started means ready: wait (up to 10 s) for the server's socket, so that dimna, started
# right after, finds the server.
ExecStartPost=/bin/sh -c 'i=0; while [ ! -S /dev/shm/jack_default_%U_0 ]; do i=$$((i + 1)); [ $$i -le 100 ] || exit 1; sleep 0.1; done'
